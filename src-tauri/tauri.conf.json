{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excel Unlock",
  "version": "0.1.0",
  "identifier": "com.personal.excelunlock",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Excel Unlock",
        "width": 460,
        "height": 600,
        "minWidth": 420,
        "minHeight": 500,
        "maxWidth": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
